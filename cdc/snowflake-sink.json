{
  "name": "snowflake-sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",

    "tasks.max": "1",

    "topics": "ecommerce.public.customers",

    "snowflake.url.name": "we78615.ap-southeast-7.aws.snowflakecomputing.com",
    "snowflake.user.name": "KAFKA_CONNECT",
    "snowflake.private.key": "",
    "snowflake.database.name": "ECOMMERCE_DW",
    "snowflake.schema.name": "RAW_CDC",
    "snowflake.role.name": "KAFKA_CONNECT_ROLE",

    "buffer.count.records": "1000",
    "buffer.flush.time": "10"
  }
}
