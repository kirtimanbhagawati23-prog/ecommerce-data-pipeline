{
  "name": "snowflake-sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",
    "tasks.max": "1",
    "topics": "ecommerce.public.customers,ecommerce.public.addresses,ecommerce.public.products,ecommerce.public.inventory,ecommerce.public.orders,ecommerce.public.order_items,ecommerce.public.payments,ecommerce.public.customer_events",
    "snowflake.url.name": "",
    "snowflake.user.name": "",
    "snowflake.private.key": "",
    "snowflake.database.name": "ECOMMERCE_DW",
    "snowflake.schema.name": "RAW_CDC",
    "snowflake.role.name": "",
    "buffer.count.records": "1000",
    "buffer.flush.time": "10",
    "snowflake.streaming.validate.compatibility.with.classic": "false",
    "snowflake.enable.schematization": "true"
  }
}